{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attack_observed_effects_schema_v1",
  "title": "Attack Observed Effects Schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "attack_id",
    "scenario_id",
    "backend",
    "generated_at",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "attack_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "effect_id",
        "effect_type",
        "status",
        "confidence"
      ],
      "properties": {
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "observed",
            "not_observed",
            "partial",
            "unknown"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "maps_to_artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "maps_to_technique": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "source"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
