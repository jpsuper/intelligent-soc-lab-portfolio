{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/wazuh_indexer_cursor_envelope.schema.json",
  "title": "wazuh_indexer_cursor_envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_fingerprint",
    "pit_id",
    "search_after",
    "returned_records",
    "expires_at"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "request_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pit_id": { "type": "string", "minLength": 1, "maxLength": 131072 },
    "search_after": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": ["string", "number"] }
    },
    "returned_records": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
