{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/siem_source_registry_entry.schema.json",
  "title": "siem_source_registry_entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "name",
    "backend",
    "connection_name",
    "physical_source",
    "time_field",
    "source_kind",
    "default_projection",
    "default_sort",
    "fixed_filters",
    "required_filters",
    "field_definitions",
    "raw_payload_fields",
    "max_query_window_seconds",
    "default_limit",
    "max_limit",
    "transport_policy",
    "adapter_name",
    "adapter_version"
  ],
  "properties": {
    "registry_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "backend": { "type": "string", "minLength": 1 },
    "connection_name": { "type": "string", "minLength": 1 },
    "physical_source": { "type": "string", "minLength": 1 },
    "time_field": { "type": "string", "minLength": 1 },
    "source_kind": { "enum": ["raw_event", "alert"] },
    "default_projection": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "default_sort": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "direction"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["asc", "desc"] }
        }
      }
    },
    "fixed_filters": {
      "type": "array",
      "items": { "$ref": "#/$defs/registryFilter" }
    },
    "required_filters": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "field_definitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "operators", "projectable", "sortable"],
        "properties": {
          "type": { "enum": ["keyword", "timestamp", "object"] },
          "operators": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["eq", "range"] }
          },
          "projectable": { "type": "boolean" },
          "sortable": { "type": "boolean" }
        }
      }
    },
    "raw_payload_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "max_query_window_seconds": { "type": "integer", "minimum": 1 },
    "default_limit": { "type": "integer", "minimum": 1 },
    "max_limit": { "type": "integer", "minimum": 1 },
    "transport_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "tls_verify",
        "connect_timeout_seconds",
        "read_timeout_seconds",
        "max_response_bytes",
        "pit_keep_alive_seconds"
      ],
      "properties": {
        "read_only": { "const": true },
        "tls_verify": { "const": true },
        "connect_timeout_seconds": { "type": "integer", "minimum": 1 },
        "read_timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_response_bytes": { "type": "integer", "minimum": 1 },
        "pit_keep_alive_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    },
    "adapter_name": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "registryFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "operator": { "const": "eq" },
        "value": { "type": ["string", "number", "integer", "boolean"] }
      }
    }
  }
}
