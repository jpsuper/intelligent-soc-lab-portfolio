{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/wazuh_windows_security_auth_hit_projection.schema.json",
  "title": "wazuh_windows_security_auth_hit_projection",
  "description": "Sanitized bounded Wazuh Indexer alert-hit projection for Windows Security 4624/4625 conversion parity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_contract_version",
    "fixture_id",
    "source_format",
    "retrieval",
    "hit"
  ],
  "properties": {
    "fixture_contract_version": { "const": "1.0" },
    "fixture_id": {
      "type": "string",
      "pattern": "^windows-security-46(?:24|25)-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{3}$"
    },
    "source_format": { "const": "wazuh_indexer_alert_hit_projection" },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_ref", "retrieved_at", "query_window"],
      "properties": {
        "query_ref": { "$ref": "#/$defs/nonEmptyString" },
        "retrieved_at": { "$ref": "#/$defs/dateTime" },
        "query_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/dateTime" },
            "end": { "$ref": "#/$defs/dateTime" }
          }
        }
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["_index", "_id", "_source"],
      "properties": {
        "_index": {
          "type": "string",
          "pattern": "^wazuh-alerts-[A-Za-z0-9._-]+$"
        },
        "_id": { "$ref": "#/$defs/nonEmptyString" },
        "_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timestamp", "agent", "manager", "data"],
          "properties": {
            "timestamp": { "$ref": "#/$defs/dateTime" },
            "agent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": { "$ref": "#/$defs/nonEmptyString" },
                "name": { "$ref": "#/$defs/nonEmptyString" }
              }
            },
            "manager": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "$ref": "#/$defs/nonEmptyString" }
              }
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["win"],
              "properties": {
                "win": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["system", "eventdata"],
                  "properties": {
                    "system": { "$ref": "#/$defs/system" },
                    "eventdata": { "$ref": "#/$defs/eventdata" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "hit": {
            "properties": {
              "_source": {
                "properties": {
                  "data": {
                    "properties": {
                      "win": {
                        "properties": {
                          "system": {
                            "properties": { "eventID": { "const": "4624" } },
                            "required": ["eventID"]
                          }
                        },
                        "required": ["system"]
                      }
                    },
                    "required": ["win"]
                  }
                },
                "required": ["data"]
              }
            },
            "required": ["_source"]
          }
        },
        "required": ["hit"]
      },
      "then": {
        "properties": {
          "hit": {
            "properties": {
              "_source": {
                "properties": {
                  "data": {
                    "properties": {
                      "win": {
                        "properties": {
                          "eventdata": {
                            "required": ["targetLogonId"],
                            "not": {
                              "anyOf": [
                                { "required": ["failureReason"] },
                                { "required": ["status"] },
                                { "required": ["subStatus"] }
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "hit": {
            "properties": {
              "_source": {
                "properties": {
                  "data": {
                    "properties": {
                      "win": {
                        "properties": {
                          "system": {
                            "properties": { "eventID": { "const": "4625" } },
                            "required": ["eventID"]
                          }
                        },
                        "required": ["system"]
                      }
                    },
                    "required": ["win"]
                  }
                },
                "required": ["data"]
              }
            },
            "required": ["_source"]
          }
        },
        "required": ["hit"]
      },
      "then": {
        "properties": {
          "hit": {
            "properties": {
              "_source": {
                "properties": {
                  "data": {
                    "properties": {
                      "win": {
                        "properties": {
                          "eventdata": {
                            "required": ["failureReason", "status", "subStatus"],
                            "not": { "required": ["targetLogonId"] }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "dateTime": { "type": "string", "format": "date-time" },
    "digitString": { "type": "string", "pattern": "^[0-9]+$" },
    "hexInteger": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
    "sid": { "type": "string", "pattern": "^S-[0-9]+(?:-[0-9]+)+$" },
    "bracedGuid": {
      "type": "string",
      "pattern": "^\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerName",
        "providerGuid",
        "eventID",
        "version",
        "level",
        "task",
        "opcode",
        "keywords",
        "systemTime",
        "eventRecordID",
        "channel",
        "computer"
      ],
      "properties": {
        "providerName": { "const": "Microsoft-Windows-Security-Auditing" },
        "providerGuid": { "$ref": "#/$defs/bracedGuid" },
        "eventID": { "enum": ["4624", "4625"] },
        "version": { "$ref": "#/$defs/digitString" },
        "level": { "$ref": "#/$defs/digitString" },
        "task": { "$ref": "#/$defs/digitString" },
        "opcode": { "$ref": "#/$defs/digitString" },
        "keywords": { "$ref": "#/$defs/nonEmptyString" },
        "systemTime": { "$ref": "#/$defs/dateTime" },
        "eventRecordID": { "$ref": "#/$defs/digitString" },
        "channel": { "const": "Security" },
        "computer": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "eventdata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectUserSid",
        "subjectLogonId",
        "targetUserSid",
        "targetUserName",
        "targetDomainName",
        "logonType",
        "logonProcessName",
        "authenticationPackageName"
      ],
      "properties": {
        "subjectUserSid": { "$ref": "#/$defs/sid" },
        "subjectUserName": { "$ref": "#/$defs/nonEmptyString" },
        "subjectDomainName": { "$ref": "#/$defs/nonEmptyString" },
        "subjectLogonId": { "$ref": "#/$defs/hexInteger" },
        "targetUserSid": { "$ref": "#/$defs/sid" },
        "targetUserName": { "$ref": "#/$defs/nonEmptyString" },
        "targetDomainName": { "$ref": "#/$defs/nonEmptyString" },
        "targetLogonId": { "$ref": "#/$defs/hexInteger" },
        "logonType": { "$ref": "#/$defs/digitString" },
        "logonProcessName": { "$ref": "#/$defs/nonEmptyString" },
        "authenticationPackageName": { "$ref": "#/$defs/nonEmptyString" },
        "workstationName": { "$ref": "#/$defs/nonEmptyString" },
        "ipAddress": {
          "oneOf": [
            { "const": "-" },
            { "type": "string", "format": "ipv4" },
            { "type": "string", "format": "ipv6" }
          ]
        },
        "ipPort": {
          "oneOf": [
            { "const": "-" },
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
            }
          ]
        },
        "failureReason": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/hexInteger" },
        "subStatus": { "$ref": "#/$defs/hexInteger" }
      }
    }
  }
}
